                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    E.job_title AS NOMBRE
FROM DB_DH.dbo.employees E
WHERE E.job_title IS NOT NULL
AND NOT EXISTS (
    SELECT 1
    FROM DW_DistribucionHardware.dbo.DIM_PuestoEmp D
    WHERE D.NOMBRE = E.job_title
);</property>
